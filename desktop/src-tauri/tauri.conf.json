{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PhotoCatalog",
  "version": "0.1.0",
  "identifier": "com.michaeltrefry.photocatalog",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "PhotoCatalog", "width": 1440, "height": 1000, "minWidth": 960, "minHeight": 640 }],
    "security": { "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'self'" }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis", "deb", "appimage"],
    "category": "Photography",
    "shortDescription": "A local photo catalog and non-destructive editor",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": { "minimumSystemVersion": "12.0" },
    "windows": { "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true } },
    "linux": { "deb": { "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"] } }
  }
}
