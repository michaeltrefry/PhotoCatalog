+def load_funding(recipe):
+    policy = evidence(recipe['funding_policy'])
+    code = raw(policy['adapter']['path'])
+    if sha(code) != policy['adapter']['sha256']:
+        raise ValueError('funding adapter changed')
+    # Execute only the exact SHA-bound adapter source, with no main dispatch.
+    import types
+    module = types.ModuleType('reviewed_funding_guard')
+    module.__file__ = policy['adapter']['path']
+    exec(compile(code, module.__file__, 'exec'), module.__dict__)
+    checked, _ = module.load_policy(recipe['funding_policy']['path'], recipe['funding_policy']['sha256'])
+    if (checked['run'] != recipe['run'] or checked['runner']['path'] != recipe['runner']
+            or checked['initial_minimum_bytes'] != recipe['minimum_free_bytes']
+            or checked['attempt'] != str(Path(recipe['control'])/'attempts'/recipe['attempt_id'])):
+        raise ValueError('funding recipe identity differs')
+    return module, checked
